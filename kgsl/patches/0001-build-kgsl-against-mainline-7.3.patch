+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Force-included in every KGSL object: renames and headers mainline moved. */
+#ifndef _KGSL_MAINLINE_H
+#define _KGSL_MAINLINE_H
+#include <linux/vmalloc.h>
+#include <linux/of.h>
+#include <linux/timer.h>
+#include <linux/remoteproc.h>
+#include "kgsl_scm.h"
+
+/* No LLC no-write-allocate hint on mainline */
+#define IOMMU_SYS_CACHE_NWA			0
+#define IO_PGTABLE_QUIRK_QCOM_USE_LLC_NWA	0
+
+/* Downstream clock debug helper and SOCCP power vote */
+#define qcom_clk_dump(clk, regulator, calltrace)	do { } while (0)
+static inline int rproc_set_state(struct rproc *rproc, bool on) { return -EOPNOTSUPP; }
+
+#define del_timer_sync	timer_delete_sync
+#define del_timer	timer_delete
+
+/* struct pages of one sg entry are always contiguous in the memmap now */
+#define nth_page(page, n)	((page) + (n))
+#endif
