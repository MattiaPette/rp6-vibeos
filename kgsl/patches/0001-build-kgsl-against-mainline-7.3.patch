--- /dev/null
+++ b/compat/msm_hw_fence.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* No hardware fence (IPCC) driver on mainline: registration always fails. */
+#ifndef _KGSL_COMPAT_MSM_HW_FENCE_H
+#define _KGSL_COMPAT_MSM_HW_FENCE_H
+#include <linux/dma-fence.h>
+#include <linux/err.h>
+#include <linux/types.h>
+#define HW_FENCE_CLIENT_ID_CTX0		0
+#define MSM_HW_FENCE_FLAG_ENABLED_BIT	31
+#define MSM_HW_FENCE_FLAG_SIGNALED_BIT	30
+struct msm_hw_fence_mem_addr { void *virtual_addr; phys_addr_t device_addr; u64 size; u32 mem_data; };
+struct msm_hw_fence_create_params { u64 *handle; struct dma_fence *fence; };
+struct msm_hw_fence_hfi_queue_table_header { u32 version, size, qhdr0_offset, qhdr_size, num_q, num_active_q; };
+struct msm_hw_fence_hfi_queue_header { u32 status, start_addr, type, queue_size, pkt_size, pkt_drop_cnt,
+	rx_wm, tx_wm, rx_req, tx_req, rx_irq_status, tx_irq_status, read_index, write_index; };
+static inline void *msm_hw_fence_register(int id, struct msm_hw_fence_mem_addr *m) { return ERR_PTR(-ENODEV); }
+static inline int msm_hw_fence_deregister(void *h) { return 0; }
+static inline int msm_hw_fence_create(void *h, struct msm_hw_fence_create_params *p) { return -ENODEV; }
+static inline int msm_hw_fence_destroy(void *h, struct dma_fence *f) { return 0; }
+static inline int msm_hw_fence_wait_update_v2(void *h, struct dma_fence **f, u64 *hh, u64 *d, u32 n, bool c) { return -ENODEV; }
+static inline int msm_hw_fence_update_txq(void *h, u64 idx, u64 flags, u32 err) { return -ENODEV; }
+static inline int msm_hw_fence_trigger_signal(void *h, u32 tx, u32 rx, u32 sig) { return -ENODEV; }
+#endif
