@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Downstream SCM calls mapped onto their mainline names. The TZ GPU DCVS
+ * service has no mainline driver, so those calls report it as absent.
+ */
+#ifndef _KGSL_COMPAT_SCM_H
+#define _KGSL_COMPAT_SCM_H
+#include <linux/firmware/qcom/qcom_scm.h>
+
+#define qcom_scm_kgsl_set_smmu_aperture(cb)	qcom_scm_set_gpu_smmu_aperture(cb)
+#define qcom_scm_kgsl_init_regs(req)		qcom_scm_gpu_init_regs(req)
+#define qcom_scm_pas_shutdown_retry(pas)	qcom_scm_pas_shutdown(pas)
+
+static inline int qcom_scm_kgsl_set_smmu_lpac_aperture(unsigned int cb) { return -EOPNOTSUPP; }
+static inline int qcom_scm_kgsl_dcvs_tuning(u32 mingap, u32 penalty, u32 numbusy) { return -ENODEV; }
+static inline int qcom_scm_io_reset(void) { return -ENODEV; }
+static inline int qcom_scm_dcvs_reset(void) { return -ENODEV; }
+static inline int qcom_scm_dcvs_update(int level, s64 total, s64 busy) { return -ENODEV; }
+static inline int qcom_scm_dcvs_update_v2(int level, s64 total, s64 busy) { return -ENODEV; }
+static inline int qcom_scm_dcvs_update_ca_v2(int level, s64 total, s64 busy, int ctx) { return -ENODEV; }
+static inline int qcom_scm_dcvs_init_v2(phys_addr_t addr, size_t size, unsigned int *version) { return -ENODEV; }
+static inline int qcom_scm_dcvs_init_ca_v2(phys_addr_t addr, size_t size) { return -ENODEV; }
+static inline bool qcom_scm_dcvs_core_available(void) { return false; }
+static inline bool qcom_scm_dcvs_ca_available(void) { return false; }
+#endif
