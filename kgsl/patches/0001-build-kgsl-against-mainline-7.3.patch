+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Mainline stand-ins for the Qualcomm downstream arm-smmu helpers. */
+#ifndef _KGSL_COMPAT_QCOM_IOMMU_UTIL_H
+#define _KGSL_COMPAT_QCOM_IOMMU_UTIL_H
+#include <linux/iommu.h>
+#include <linux/io-pgtable.h>
+#include <linux/qcom-io-pgtable.h>
+
+/* Fault reasons the downstream arm-smmu passes to fault handlers. */
+#define IOMMU_FAULT_TRANSLATION		BIT(2)
+#define IOMMU_FAULT_PERMISSION		BIT(3)
+#define IOMMU_FAULT_EXTERNAL		BIT(4)
+#define IOMMU_FAULT_TRANSACTION_STALLED	BIT(5)
+
+#define QCOM_IOMMU_FAULT_MODEL_NON_FATAL	BIT(0)
+#define QCOM_IOMMU_FAULT_MODEL_NO_CFRE		BIT(1)
+#define QCOM_IOMMU_FAULT_MODEL_NO_STALL		BIT(2)
+#define QCOM_IOMMU_FAULT_MODEL_HUPCF		BIT(3)
+
+/* mainline arm-smmu-qcom always gives the GPU context bank 0 */
+static inline int qcom_iommu_get_context_bank_nr(struct iommu_domain *d) { return 0; }
+static inline int qcom_iommu_get_asid_nr(struct iommu_domain *d) { return 0; }
+static inline int qcom_iommu_set_fault_model(struct iommu_domain *d, int m) { return 0; }
+static inline int qcom_iommu_set_secure_vmid(struct iommu_domain *d, int v) { return -EOPNOTSUPP; }
+static inline void qcom_skip_tlb_management(struct device *dev, bool skip) { }
+#endif
