# RP6 fragment, merged last by scripts/10-build-kernel.sh so it wins over
# defconfig and over the DT-derived symbols (dt2config.py, all built in).
# It holds what the DT cannot tell us, what we want to drop, and the drivers
# that must stay modules.

# --- Retroid-specific drivers (not in defconfig) ---
CONFIG_SERIAL_DEV_BUS=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_RSINPUT=m
CONFIG_LEDS_HTR3212=m
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_SND_SOC_AW88166=m
CONFIG_SND_SOC_WCD938X_SDW=m

# --- Load firmware at probe: modules, so the firmware is on the rootfs by then ---
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_ATH12K=m
CONFIG_BT_HCIUART=m
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_QCOM_FASTRPC=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_QDSP6_APM=m
CONFIG_SND_SOC_QDSP6_APM_DAI=m
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=m
CONFIG_SND_SOC_QDSP6_PRM=m
CONFIG_SND_SOC_QDSP6_PRM_LPASS_CLOCKS=m
CONFIG_SND_SOC_WCD938X=m

# --- Screen on from the first second, so boot logs show without a rootfs ---
# The display path needs no firmware; the GPU loads its own only when opened.
CONFIG_DRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# OCMEM exists only on older SoCs; as a module it would force DRM_MSM=m.
# CONFIG_QCOM_OCMEM is not set
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_VISIONOX_VTDR6130=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Shows the kernel log on the framebuffer OpenABL leaves, before msm takes over.
CONFIG_DRM_SIMPLEDRM=y
# mdss also drives the DisplayPort-over-USB-C output; the msm display only
# comes up once every part of that chain has probed, so none may be a module.
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_TYPEC_MUX_GPIO_SBU=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_DRM_AUX_BRIDGE=y
CONFIG_DRM_AUX_HPD_BRIDGE=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y

# --- OpenABL starts the kernel through its EFI stub ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# --- Needed before the rootfs is mounted (no initramfs) ---
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# --- Memory: compressed RAM swap instead of disk swap ---
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# --- Waydroid (Android container that runs DroidDeck) ---
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NF_NAT=m
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- What DroidDeck's runtime does inside Android (proot, Wine, FEX) ---
CONFIG_ARM64_VA_BITS_48=y
CONFIG_COMPAT=y
CONFIG_USERFAULTFD=y
CONFIG_FUTEX=y

# --- Drop what a single-purpose handheld never uses ---
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_XEN is not set
# CONFIG_HIBERNATION is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_WIRELESS_EXT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_LIMA is not set
CONFIG_LOCALVERSION="-rp6"
# CONFIG_LOCALVERSION_AUTO is not set
