# Shared build settings. Sourced by every script in scripts/.

# Upstream sources released by Retroid Pocket
KERNEL_REPO=https://github.com/RetroidPocket/linux
KERNEL_BRANCH=retroidpocket/v7.3
TOPOLOGY_REPO=https://github.com/RetroidPocket/audioreach-topology
TOPOLOGY_BRANCH=retroidpocket/v1.0.5
UCM_REPO=https://github.com/RetroidPocket/alsa-ucm-conf
UCM_BRANCH=retroidpocket/v1.2.16
LINUX_FIRMWARE_REPO=https://gitlab.com/kernel-firmware/linux-firmware.git
# Qualcomm KGSL GPU driver (experimental, scripts/15-build-kgsl.sh). CodeLinaro
# is the origin; the LineageOS GitHub mirror carries the same tree and is faster.
KGSL_REPO=https://github.com/LineageOS/android_kernel_qcom_sm8750-modules
KGSL_COMMIT=14ab4c38ac7f07d2b807ca7851500da86d2eb56e

# Device
DTB=qcom/qcs8550-retroidpocket-rp6.dtb
SOC=sm8550
TOPOLOGY_NAME=SM8550-RetroidPocket-I2S

# Rootfs (glibc is required by Steam, pressure-vessel and FEX)
DEBIAN_SUITE=trixie
DEBIAN_MIRROR=http://deb.debian.org/debian

# Kernel command line. The root partition is found by its GPT label, so it
# works the same from microSD or, later, from UFS.
ROOT_LABEL=rp6-root
# Bring-up: full kernel log on screen, and keep the clocks and power domains
# the bootloader left on (the panel among them) until their drivers claim them.
CMDLINE="root=PARTLABEL=$ROOT_LABEL rootwait rw console=tty0 loglevel=7 clk_ignore_unused pd_ignore_unused"

# Layout
TOP=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SRC=${SRC:-$TOP/src}
OUT=${OUT:-$TOP/out}
CROSS_COMPILE=${CROSS_COMPILE:-aarch64-linux-gnu-}
JOBS=${JOBS:-$(nproc)}
